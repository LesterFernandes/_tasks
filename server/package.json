{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/server.js",
    "dev": "nodemon",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migration:gen": "pnpm drizzle-kit generate",
    "migration:apply": "pnpm drizzle-kit migrate"
  },
  "dependencies": {
    "@fastify/autoload": "^6.6.0",
    "close-with-grace": "^2.5.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "1.0.0-rc.5",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.5",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  }
}
